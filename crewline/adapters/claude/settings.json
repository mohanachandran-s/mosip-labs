{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git stash *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .claude/hooks/crewline_hook.py --claude shell"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .claude/hooks/crewline_hook.py --claude write"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .claude/hooks/crewline_hook.py --claude read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .claude/hooks/crewline_hook.py --claude session"
          }
        ]
      }
    ]
  }
}
