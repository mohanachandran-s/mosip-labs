{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crewline/task-manifest.schema.json",
  "title": "Crewline task manifest",
  "description": "Orchestration record (Blueprint v2.1 §10). NOT a testcase or requirements schema: testcases live in API TestRig YAML / the coverage matrix / the repository's unit tests; requirements in the issue tracker.",
  "type": "object",
  "required": [
    "task_id",
    "outcome",
    "current_state",
    "scope",
    "requirements",
    "testcases",
    "repair",
    "reviews",
    "gates",
    "approvals",
    "evidence_refs",
    "github"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "outcome": {
      "enum": [
        "IN_PROGRESS",
        "SUCCESS",
        "PARTIAL",
        "BLOCKED",
        "ESCALATED",
        "FAILED"
      ]
    },
    "current_state": {
      "type": "string"
    },
    "resume_state": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "module",
        "repositories"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "track": {
          "enum": [
            "API",
            "UI",
            "DSL",
            "SERVICE",
            "MIXED"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "base_ref": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "baseline_commit": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "primary",
                  "dependency",
                  "reference"
                ],
                "description": "primary = the module the task is for; dependency = a repo that needs its own change (e.g. apitest-commons); reference = read-only"
              },
              "upstream_repo": {
                "type": "string"
              },
              "upstream_remote": {
                "type": "string"
              },
              "base_branch": {
                "type": "string"
              },
              "head_commit": {
                "type": "string"
              },
              "origin": {
                "type": "string"
              },
              "pull_request": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "names of repositories whose PR must exist (and be referenced) before this one's PR"
              },
              "version_link": {
                "type": "string",
                "description": "how the primary consumes the dependency change, e.g. 'pom apitest-commons 1.6.0 -> 1.6.1-SNAPSHOT' or 'none: released version already contains it'"
              },
              "allow_commits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "commits the user asked to include (existing PR): crewline gates refresh passes them to `branch --allow`"
              }
            }
          }
        },
        "approved_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "glob patterns (relative to each repo root) the plan authorises; change-scope blocks anything else"
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "source_refs",
        "acceptance_criteria",
        "open_ambiguities"
      ],
      "properties": {
        "story_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "matrix_row_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "code_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "repo-relative file[:symbol] that implements the AC"
              },
              "test_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "uniqueIdentifier or fully qualified unit test name"
              },
              "nfr": {
                "type": "boolean"
              },
              "api": {
                "type": "boolean",
                "description": "the AC is observable at an API boundary (status / error code / body)"
              },
              "component_test_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "tests at the HTTP boundary (MockMvc / @WebMvcTest / @SpringBootTest); required when system tests are NOT_APPLICABLE (TRC-007)"
              },
              "ui": {
                "type": "boolean",
                "description": "observable in a user interface"
              },
              "system_test_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "TestRig uniqueIdentifier / UI rig scenario proving the AC end to end (TRC-008/009)"
              },
              "resource_limits": {
                "type": "array",
                "items": {
                  "enum": [
                    "input_size",
                    "nesting_depth",
                    "memory",
                    "time",
                    "error_behaviour"
                  ]
                },
                "description": "which limit this non-functional AC states (REQ-005)"
              }
            }
          }
        },
        "open_ambiguities": {
          "type": "integer",
          "minimum": 0
        },
        "untrusted_input": {
          "type": "boolean",
          "description": "the change parses input it does not control (QR, CBOR, files, uploads, ...): needs resource-limit ACs (REQ-005) and a threat review before test design (PKT-005)"
        }
      }
    },
    "testcases": {
      "type": "object",
      "required": [],
      "properties": {
        "canonical_format": {
          "enum": [
            "existing-api-testrig-yaml",
            "none"
          ]
        },
        "traceability": {
          "const": "coverage-matrix"
        },
        "unique_identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matrix_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit_test_framework": {
          "type": "string"
        }
      }
    },
    "repair": {
      "type": "object",
      "required": [
        "attempt_count",
        "attempt_history"
      ],
      "properties": {
        "failure_fingerprint": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "",
            "AUTOMATION",
            "CODE_UNDER_CHANGE",
            "APPLICATION",
            "TEST_DATA",
            "ENVIRONMENT",
            "SPECIFICATION",
            "UNKNOWN",
            "SECURITY"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_history": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "attempt",
              "hypothesis",
              "changed_files",
              "outcome"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "hypothesis": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changed_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "validator_results": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outcome": {
                "enum": [
                  "FIXED",
                  "STILL_FAILING",
                  "NEW_FAILURE"
                ]
              },
              "track": {
                "enum": [
                  "sdet",
                  "dev"
                ],
                "description": "absent = sdet"
              }
            }
          }
        },
        "dev_attempt_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviews": {
      "type": "object",
      "properties": {
        "implementation_review": {
          "enum": [
            "NOT_STARTED",
            "PASS",
            "FINDINGS",
            "WAIVED"
          ]
        },
        "fresh_context_review": {
          "enum": [
            "NOT_STARTED",
            "PASS",
            "FINDINGS",
            "WAIVED"
          ]
        },
        "reviewers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "review name -> reviewer context id; must not be an author (MAN-011)"
        },
        "security_review": {
          "enum": [
            "NOT_STARTED",
            "PASS",
            "FINDINGS",
            "WAIVED",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checked_at_commit": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "description": "when the gate was last run (crewline gates refresh)"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tracker": {
      "type": "object",
      "description": "The GitHub issue or Jira item this task belongs to, settled at INPUT_VALIDATION before any design or code (core/workflow.yaml tracker_guard, MAN-017): linked after the user confirmed it, created by Crewline on approval create_tracker_item, or waived by a human with a reason.",
      "properties": {
        "system": {
          "enum": [
            "github",
            "jira"
          ]
        },
        "key": {
          "type": "string",
          "description": "github: owner/repo#N (or #N on the primary upstream repo); jira: PROJ-123. Task commit subjects carry it (crewline branch BR-002); the PR title/body link it"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "issue_type": {
          "type": "string",
          "description": "jira: story | bug | task (or the project's own type); github: the label used"
        },
        "found_by": {
          "enum": [
            "request",
            "branch",
            "commit",
            "search",
            "created"
          ],
          "description": "where the ticket came from"
        },
        "created_by_crewline": {
          "type": "boolean",
          "description": "true needs an approval record with action create_tracker_item (MAN-017)"
        },
        "confirmed_by": {
          "type": "string",
          "description": "the human who confirmed the link or approved the creation; never an agent (MAN-010)"
        },
        "linked_at": {
          "type": "string"
        },
        "waived": {
          "$ref": "#/$defs/approval",
          "description": "the user declined a ticket: action tracker_waiver, approver, reason, scope, timestamp"
        },
        "closure": {
          "type": "object",
          "description": "closure comment on the ticket at PR_CLOSEOUT / FINAL_REPORT (FINAL_REPORT->DONE guard)",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "posted",
                "declined"
              ]
            },
            "ref": {
              "type": "string",
              "description": "comment URL or id when posted"
            },
            "at": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "description": "why the user declined it"
            }
          }
        },
        "subtasks": {
          "type": "array",
          "description": "GITHUB_PLANNING (SDET plan 7.5): one per kind the template lists (core/workflow.yaml subtask_kinds), under tracker.key in the same system; MAN-018",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "key"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "description": "testcase | automation | implementation | testing | review | pr (template `subtasks`)"
              },
              "key": {
                "type": "string",
                "description": "same format as tracker.key (GitHub sub-issue owner/repo#N or #N; Jira sub-task PROJ-124)"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "created_by_crewline": {
                "type": "boolean",
                "description": "true needs an approval create_tracker_subtasks (MAN-018)"
              },
              "closure": {
                "type": "object",
                "description": "closure comment on the ticket at PR_CLOSEOUT / FINAL_REPORT (FINAL_REPORT->DONE guard)",
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "posted",
                      "declined"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "description": "comment URL or id when posted"
                  },
                  "at": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "description": "why the user declined it"
                  }
                }
              }
            }
          }
        },
        "subtasks_waived": {
          "$ref": "#/$defs/approval",
          "description": "the user declined subtasks for this task: action subtasks_waiver, approver, reason, scope, timestamp (MAN-018)"
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "issue": {
          "type": [
            "string",
            "null"
          ],
          "description": "legacy: the GitHub issue; tracker.key is the source of truth"
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pull_request": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "knowledge_delta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_report_ref": {
      "type": "string"
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "at"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "task_type": {
      "enum": [
        "feature",
        "bug-fix",
        "refactor",
        "dependency-upgrade",
        "database-migration",
        "incident",
        "release",
        "test-automation",
        "module-onboarding",
        "documentation"
      ],
      "description": "selects core/workflows/<task_type>.yaml; absent = test-automation (SDET assistant manifests)"
    },
    "risk_tier": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "design": {
      "type": "object",
      "properties": {
        "document_ref": {
          "type": "string"
        },
        "adr_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migration_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "agent/context ids or people that wrote the change"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "crewline run records for the module's lint/format checkers (coding_standards gate)"
        },
        "robustness": {
          "type": "object",
          "description": "exception reuse and error paths (robustness gate); required for feature/bug-fix/migration/upgrade before review",
          "properties": {
            "exception_reuse": {
              "type": "string",
              "description": "file:line of the module exception handler / error constant reused; do not invent a new type"
            },
            "hot_path_notes": {
              "type": "string",
              "description": "why this is not an extra round-trip or N+1; name the existing service/repo call"
            },
            "error_paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ac_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "error_code": {
                    "type": "string"
                  },
                  "test_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "test_results": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "SKIP",
          "NOT_RUN",
          "DEFERRED"
        ]
      },
      "description": "test id -> latest result on the branch HEAD (from evidence records)"
    },
    "pr": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "the PR title as on GitHub; starts with the tracker key, `<KEY>: summary` (MAN-017 when leaving PR_CLOSEOUT, GRD-009 on gh pr create/edit)"
        },
        "valid_comments_open": {
          "type": "integer",
          "minimum": 0
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "url": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "ci_status": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "monitoring": {
          "enum": [
            "none",
            "app",
            "gh-watch",
            "manual-confirmed"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "CI/review events handled in PR_CLOSEOUT, each with its disposition"
        },
        "unresolved_threads": {
          "type": "integer",
          "minimum": 0,
          "description": "review threads still unresolved on the PR head (gh api graphql reviewThreads isResolved=false)"
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "readiness": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_STARTED",
            "READY",
            "NOT_READY"
          ]
        },
        "environment": {
          "type": "string"
        },
        "environment_class": {
          "enum": [
            "non-production",
            "production"
          ]
        },
        "rollback_plan_ref": {
          "type": "string"
        },
        "deployment_record_ref": {
          "type": "string"
        }
      }
    },
    "knowledge_delta_reviewed": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "description": "ISO time the task began (usage is attributed from here)"
    },
    "finished_at": {
      "type": "string"
    },
    "initial_state": {
      "type": "string",
      "description": "state at started_at (usage before the first transition)"
    },
    "usage_marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "at"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "description": "step boundaries for crewline usage (one per meaningful step)"
    },
    "usage_ref": {
      "type": "string",
      "description": "path of usage.md produced by crewline usage"
    },
    "usage": {
      "type": "object",
      "description": "optional overlay of core/usage-budget.yaml for this task",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "per_task": {
              "type": "integer",
              "minimum": 1
            },
            "per_state": {
              "type": "integer",
              "minimum": 1
            },
            "warn_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "packet_max_chars": {
              "type": "integer",
              "minimum": 1000
            }
          }
        }
      }
    },
    "test_plan": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "where system tests run on the branch build"
        },
        "environment_kind": {
          "enum": [
            "branch-deployed-env",
            "local-stack",
            "post-merge-deferred",
            "local-test-rig"
          ]
        },
        "new_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regression_suites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "existing TestRig/UI suites proving nothing existing broke"
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "found_by": {
            "type": "string"
          },
          "class": {
            "enum": [
              "CODE_UNDER_CHANGE",
              "APPLICATION",
              "SECURITY",
              "AUTOMATION",
              "TEST_DATA",
              "ENVIRONMENT"
            ]
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "raised",
              "deferred"
            ]
          },
          "bug": {
            "type": "string",
            "description": "Jira key when raised"
          },
          "fix_commit": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "report_path": {
            "type": "string",
            "description": "secret-scanned error report (never a raw full dump); required for APPLICATION/SECURITY (defect-reports gate)"
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "checkout_mode": {
          "enum": [
            "worktree",
            "single"
          ]
        },
        "clone": {
          "type": "string",
          "description": "the user's existing clone (one per repository)"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "purpose": {
                "enum": [
                  "task",
                  "base"
                ]
              },
              "removed_at": {
                "type": "string"
              }
            }
          }
        },
        "open_worktrees": {
          "type": "integer",
          "minimum": 0
        },
        "original_branch": {
          "type": "string",
          "description": "single-checkout mode: branch to restore at the end"
        },
        "context_dir": {
          "type": "string",
          "description": "the module's .crewline/ folder when the task worktree's base does not carry it (crewline task worktree, ADR-0009)"
        }
      }
    },
    "crewline_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Crewline version the task started on (recorded at INTAKE: `crewline version`); MAN-016 warns when the installed Crewline differs"
    },
    "known_limitations": {
      "type": "array",
      "description": "findings the task ships with; each links a follow-up by FINAL_REPORT (MAN-019). Write with `crewline limitation add`",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "follow_up": {
            "type": "string",
            "description": "ticket key or URL, or the follow-up task id"
          },
          "no_follow_up": {
            "type": "string",
            "description": "why none is needed, as the user accepted it"
          }
        }
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "required": [
        "action",
        "approver",
        "reason",
        "scope",
        "timestamp"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "approver": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "approver_type": {
          "enum": [
            "human",
            "agent"
          ],
          "description": "agent is always rejected (MAN-010)"
        },
        "gate": {
          "type": "string",
          "description": "for a gate exception: the gate it covers"
        },
        "consumed_by": {
          "type": "string"
        },
        "follow_up": {
          "type": "string",
          "description": "for a gate exception: the ticket or task that closes what was waived (MAN-019)"
        },
        "no_follow_up": {
          "type": "string",
          "description": "for a gate exception: why none is needed, as the user accepted it"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "regression_deferred: the cases this one approval covers (never the whole gate)"
        },
        "bug": {
          "type": "string",
          "description": "regression_deferred: the raised bug the cases are deferred to"
        },
        "kind": {
          "enum": [
            "no_code_change",
            "user_waiver"
          ],
          "description": "full_regression_waiver: why it was not run"
        }
      }
    }
  }
}
